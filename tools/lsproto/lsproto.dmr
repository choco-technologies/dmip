# DMOD Resource File for lsproto
# This file specifies where resources should be installed
#
# lsproto lives nested under tools/lsproto/ inside this repo (a second
# module built by the repo-root CMakeLists.txt via
# add_subdirectory(tools/lsproto)), so ${repo_dir}/${build_dir} below
# (which always resolve to the dmip repo/build root, not this
# subdirectory) are prefixed with tools/lsproto/ - same convention
# dmip.dmr itself documents for its own (currently hypothetical) nesting
# under a parent dmnet repo.

# === Core Module ===
# Main module file - always installed
dmf=./${module}.dmf => ${destination}/${module}.dmf [origin=${dmf_dir}/${module}.dmf]

# Compressed module
dmfc=./${module}.dmfc => ${destination}/${module}.dmfc [origin=${build_dir}/dmfc/${module}.dmfc]

# Dependencies file (if exists)
dmd=./${module}.dmd => ${destination}/${module}.dmd [origin=${dmf_dir}/${module}.dmd]

# Version information
version=./${module}_version.txt => ${destination}/${module}_version.txt [origin=${dmf_dir}/${module}_version.txt]

# === Documentation ===
# Module documentation in markdown format for dmf-man tool
docs=./docs => ${destination}/${module}/docs [origin=${repo_dir}/tools/lsproto/docs]

# README file
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/tools/lsproto/README.md]

# === Header Files ===
# lsproto has no public header of its own (it's an application module, not
# a library) - include/ only carries the auto-generated lsproto_defs.h,
# same "empty include/ + generated defs header" shape every DMOD
# application module's package has.
inc=./include => ${destination}/${module}/include [origin=${repo_dir}/tools/lsproto/include] [origin=${build_dir}/tools/lsproto/${module}_defs.h]

# === License ===
# License file - shared at the dmip repo root
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

# Adding itself
dmr=./${module}.dmr => ${destination}/${module}/${module}.dmr [origin=${repo_dir}/tools/lsproto/${module}.dmr]
